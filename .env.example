UPSTAGE_API_KEY=
UPSTAGE_AGENT_ID=

# Optional school Gateway. Keep blank to disable; never put real keys in Git.
FACTCHAT_API_KEY=
# Set an exact ID from your account's /models/?type=llm response after checking pricing.
FACTCHAT_MODEL=
# Generation attempts per server process, including failures. 0 disables requests.
FACTCHAT_MAX_REQUESTS=1
# Official strict schema output; prompt_json is an explicit model-compatibility opt-out.
# Both modes retain local evidence/medical safety validation. No automatic retry.
FACTCHAT_RESPONSE_FORMAT=json_schema
